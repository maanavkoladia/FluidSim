{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug sim (use Makefile exe)",
            "type": "cppdbg",
            "request": "launch",

            // <-- CHANGE THIS to your real executable path
            "program": "${workspaceFolder}/FluidSim.elf",

            "args": [],
            "stopAtEntry": false,

            // You can keep cwd at workspace root or wherever you want
            "cwd": "${workspaceFolder}",

            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],

            // <-- REMOVE this line so VS Code does NOT try to rebuild
            // "preLaunchTask": "C/C++: gcc-13 build active file"
        }
    ]
}

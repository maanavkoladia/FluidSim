#include <stdlib.h>
#include <stdbool.h>
#include <math.h>

// ---------------------------------------------------------
// Basic math helpers / types
// ---------------------------------------------------------

typedef struct {
    float x;
    float y;
} Vector2;

static inline Vector2 vec2_add(Vector2 a, Vector2 b) {
    Vector2 r = { a.x + b.x, a.y + b.y };
    return r;
}

static inline Vector2 vec2_sub(Vector2 a, Vector2 b) {
    Vector2 r = { a.x - b.x, a.y - b.y };
    return r;
}

static inline Vector2 vec2_scale(Vector2 v, float s) {
    Vector2 r = { v.x * s, v.y * s };
    return r;
}

static inline float clamp_float(float v, float minVal, float maxVal) {
    if (v < minVal) return minVal;
    if (v > maxVal) return maxVal;
    return v;
}

static inline int clamp_int(int v, int minVal, int maxVal) {
    if (v < minVal) return minVal;
    if (v > maxVal) return maxVal;
    return v;
}

static inline float clamp01(float v) {
    return clamp_float(v, 0.0f, 1.0f);
}

static inline float lerp(float a, float b, float t) {
    return a + (b - a) * t;
}

// ---------------------------------------------------------
// 2D array helpers
// ---------------------------------------------------------

static float** alloc_float_2d(int width, int height) {
    float** arr = (float**)malloc(sizeof(float*) * width);
    if (!arr) return NULL;
    for (int x = 0; x < width; x++) {
        arr[x] = (float*)calloc((size_t)height, sizeof(float));
        if (!arr[x]) {
            // cleanup on failure
            for (int i = 0; i < x; i++) free(arr[i]);
            free(arr);
            return NULL;
        }
    }
    return arr;
}

static bool** alloc_bool_2d(int width, int height) {
    bool** arr = (bool**)malloc(sizeof(bool*) * width);
    if (!arr) return NULL;
    for (int x = 0; x < width; x++) {
        arr[x] = (bool*)calloc((size_t)height, sizeof(bool));
        if (!arr[x]) {
            for (int i = 0; i < x; i++) free(arr[i]);
            free(arr);
            return NULL;
        }
    }
    return arr;
}

static void free_float_2d(float** arr, int width) {
    if (!arr) return;
    for (int x = 0; x < width; x++) {
        free(arr[x]);
    }
    free(arr);
}

static void free_bool_2d(bool** arr, int width) {
    if (!arr) return;
    for (int x = 0; x < width; x++) {
        free(arr[x]);
    }
    free(arr);
}

// ---------------------------------------------------------
// PressureSolveData struct
// ---------------------------------------------------------

typedef struct {
    float flowLeft;
    float flowRight;
    float flowTop;
    float flowBottom;
    int   flowEdgeCount;
    bool  isSolid;
    float velocityTerm;
} PressureSolveData;

// ---------------------------------------------------------
// FluidGrid struct
// ---------------------------------------------------------

typedef struct {
    int   CellCountX;
    int   CellCountY;
    float CellSize;

    // Velocities on staggered grid
    float** VelocitiesX;       // size: (CellCountX+1) x (CellCountY)
    float** VelocitiesY;       // size: (CellCountX)   x (CellCountY+1)
    float** VelocitiesX_Temp;  // same size as VelocitiesX
    float** VelocitiesY_Temp;  // same size as VelocitiesY

    bool**             SolidCellMap;         // size: CellCountX x CellCountY
    PressureSolveData** PressureSolveDataMap; // size: CellCountX x CellCountY

    float** PressureMap;   // size: CellCountX x CellCountY
    float** SmokeMap;      // size: CellCountX x CellCountY
    float** SmokeMapTemp;  // size: CellCountX x CellCountY

    float TimeStepMul;
    float SOR;

    Vector2 boundsSize;
    Vector2 bottomLeft;
    float   halfCellSize;
} FluidGrid;

// Density is constant 1 in the C# code
static const float Density = 1.0f;

// TimeStep property: TimeStep = (1/60) * TimeStepMul
static inline float FluidGrid_TimeStep(const FluidGrid* g) {
    return (1.0f / 60.0f) * g->TimeStepMul;
}

